@using SPTarkov.Server.Core.Models.Eft.Game
@using Microsoft.JSInterop
@inject IJSRuntime JS

<section class="p-2 h-full">
    @* Items are positioned in multiples of two css variables. expansions-shop.js sets the cell
       height from the rendered width so the cells come out square, then drops the pending class. *@
    <div class="grid-stack grid-stack--pending"
         data-rows="@Rows"
         style="--grid-column-width: 25%; --grid-margin-top: 10px; --grid-margin-right: 10px; --grid-margin-bottom: 10px; --grid-margin-left: 10px;">
    @foreach (var block in Blocks)
    {
        var price = Prices.GetValueOrDefault(block.OfferId.ToString());

        <div class="grid-stack-item" style="@ItemStyle(block)">
            <div class="grid-stack-item-content @ContentClass(block)">
                @* The inner wrapper carries the card shadow, the hover lift and the orange accent
                   underneath it. Without it the tiles sit flat. *@
                <div class="grid-stack-item-content__inner">
                    <ProductCard Block="block"
                                 Price="price"
                                 Token="@Token"
                                 CanBuy="price is not null && Balance >= price.AmountWithDiscount"
                                 Purchased="!block.Countable && (PurchasedOffers?.Contains(block.OfferId.ToString()) ?? false)"
                                 OnBuy="OnBuy"/>
                </div>
            </div>
        </div>
    }
    </div>
</section>

@code {
    /// <summary>
    ///     Retake the grid cell height, which comes from the rendered width. Blazor replaces the
    ///     prerendered grid with its own node
    /// </summary>
    /// <param name="firstRender">Whether this is the first render</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("shopLayoutMosaic");
    }

    [Parameter]
    [EditorRequired]
    public required List<ShopBlock> Blocks { get; set; }

    [Parameter]
    [EditorRequired]
    public required Dictionary<string, ShopPrice> Prices { get; set; }

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public int Balance { get; set; }

    [Parameter]
    public HashSet<string>? PurchasedOffers { get; set; }

    [Parameter]
    public EventCallback<string> OnBuy { get; set; }

    private int Rows => Blocks.Count == 0 ? 0 : Blocks.Max(block => block.Position.Y + Size(block).Height);

    private static string ItemStyle(ShopBlock block)
    {
        var (width, height) = Size(block);

        return $"top: calc({block.Position.Y} * var(--grid-cell-height)); "
            + $"left: calc({block.Position.X} * var(--grid-column-width)); "
            + $"width: calc({width} * var(--grid-column-width)); "
            + $"height: calc({height} * var(--grid-cell-height));";
    }

    /// <summary>
    ///     Get the content class that picks the hover underline colour. Free offers use the free tag colour
    /// </summary>
    /// <param name="block">Tile to style</param>
    /// <returns>Content modifier class</returns>
    private static string ContentClass(ShopBlock block)
    {
        return block.Tags.Contains("FREE") ? "grid-stack-item-content--free" : "grid-stack-item-content--default";
    }

    /// <summary>
    ///     Get a tile's size in grid cells. The ratio is rows first, so "1:2" is one row two columns wide.
    ///     Read the other way round the pages do not tile
    /// </summary>
    /// <param name="block">Tile to measure</param>
    /// <returns>Width and height in cells</returns>
    private static (int Width, int Height) Size(ShopBlock block)
    {
        var parts = (block.AspectRatio ?? "1:1").Split(':');
        var width = parts.Length == 2 && int.TryParse(parts[1], out var w) ? Math.Max(1, w) : 1;
        var height = parts.Length == 2 && int.TryParse(parts[0], out var h) ? Math.Max(1, h) : 1;

        return (width, height);
    }
}
