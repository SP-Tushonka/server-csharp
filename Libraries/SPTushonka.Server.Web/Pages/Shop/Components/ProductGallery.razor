@using Microsoft.JSInterop
@using SPTarkov.Server.Core.Models.Eft.Game
@inject IJSRuntime JS

<div class="product-gallery">
    <div class="product-gallery__viewer">
        <img @key="_shown" class="product-gallery__main-img @(_visible ? "product-gallery__main-img--visible" : null)"
             src="@(Current.Url ?? Current.ImageUrl)" alt="" draggable="false" @onload="OnImageSettled" @onerror="OnImageSettled"/>

        @if (_video)
        {
            <video class="product-gallery__video" src="/files/shop/Animation_NOISE_BG_EKRAN.webm"
                   autoplay muted playsinline loop draggable="false"></video>
        }

        @if (Images.Count > 1 || (Images.Count == 1 && !IsImage(Images[0])))
        {
            <div class="product-gallery__thumbs">
                @for (var index = 0; index < Images.Count; index++)
                {
                    var target = index;
                    var active = _selected == target || _previewing == target;
                    <div class="product-gallery__thumb @(active ? "product-gallery__thumb--active" : null)" @onclick="() => OnThumbClick(target)">
                        <img src="@Images[target].ThumbUrl" loading="lazy" class="w-full h-full object-cover" alt="" draggable="false"/>
                        @if (Images[target].Type == ShopDemonstrationItemType.Sound)
                        {
                            <img class="textures-icon product-gallery__thumb__icon" src="/files/shop/ExpansionsHub_Gallery_Icon_Sound.png" alt="" draggable="false"/>
                        }
                        <div class="product-gallery__thumb__vignette"></div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public required List<ShopDemonstrationItem> Images { get; set; }

    private int _shown;
    private int _selected = -1;
    private int _previewing = -1;
    private bool _visible;
    private bool _video;
    private bool _switching;
    private TaskCompletionSource? _settled;

    private ShopDemonstrationItem Current => _shown < Images.Count ? Images[_shown] : new ShopDemonstrationItem();

    protected override void OnInitialized()
    {
        _selected = Images.Count > 0 && IsImage(Images[0]) ? 0 : -1;
    }

    private static bool IsImage(ShopDemonstrationItem item)
    {
        return item.Type == ShopDemonstrationItemType.Image;
    }

    /// <summary>
    ///     Handle a thumbnail click. A sound entry has the game play its voice line and stays lit for two
    ///     seconds as live does, and an image entry is switched to
    /// </summary>
    /// <param name="index">Thumbnail clicked</param>
    private async Task OnThumbClick(int index)
    {
        var item = Images[index];
        if (IsImage(item))
        {
            await SwitchTo(index);

            return;
        }

        if (item.Type != ShopDemonstrationItemType.Sound || string.IsNullOrEmpty(item.Sound))
        {
            return;
        }

        _previewing = index;
        _ = JS.InvokeVoidAsync("shopPlaySoundPreview", item.Sound).AsTask();
        StateHasChanged();
        await Task.Delay(2000);

        if (_previewing == index)
        {
            _previewing = -1;
            StateHasChanged();
        }
    }

    /// <summary>
    ///     Handle the main image loading or failing. The first image fades in once loaded, and during a switch the load is awaited instead
    /// </summary>
    private void OnImageSettled()
    {
        if (_settled is not null)
        {
            _settled.TrySetResult();

            return;
        }

        if (!_switching)
        {
            _visible = true;
        }
    }

    /// <summary>
    ///     Switch to another image. The image hides under the noise video, swaps after 300ms once the new one
    ///     loads, then fades in, and clicks are taken again 300ms later
    /// </summary>
    /// <param name="index">Image to show</param>
    private async Task SwitchTo(int index)
    {
        if (index == _selected || _switching)
        {
            return;
        }

        _switching = true;
        _video = true;
        _visible = false;
        _ = JS.InvokeVoidAsync("shopSound", "OfferViewSwitchClick").AsTask();
        _ = JS.InvokeVoidAsync("shopSound", "OfferViewSwitchAnimationStart").AsTask();
        StateHasChanged();
        await Task.Delay(300);

        _settled = new TaskCompletionSource();
        _shown = index;
        _selected = index;
        StateHasChanged();
        await Task.WhenAny(_settled.Task, Task.Delay(5000));
        _settled = null;

        _video = false;
        StateHasChanged();
        await Task.Delay(32);

        _visible = true;
        StateHasChanged();
        await Task.Delay(300);
        _switching = false;
    }
}
