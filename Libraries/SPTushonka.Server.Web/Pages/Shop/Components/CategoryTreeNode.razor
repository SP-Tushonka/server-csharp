@using SPTarkov.Server.Core.Models.Eft.Game
@using SPTarkov.Server.Core.Services.Commerce

@inject TarcoinStoreService TarcoinStoreService

@{
    var name = TarcoinStoreService.Localise(Node.NameKey, Language);
}

@* The button is a grid of icon, label and an empty last column. The state markers are positioned
   over the whole button, so they take no column of their own. *@
<li class="category-tree-node">
    <button type="button"
            class="category-tree-node__button btn-grid-overlay @(Active ? "category-tree-node__button--active" : null)"
            tabindex="-1"
            @onclick="() => OnSelect.InvokeAsync(Node)">
        <span class="category-tree__node-icon">
            @if (!string.IsNullOrEmpty(Node.IconUrl))
            {
                <img class="object-contain"
                     src="@(Active && !string.IsNullOrEmpty(Node.SelectedIconUrl) ? Node.SelectedIconUrl : Node.IconUrl)"
                     alt="@name" draggable="false"/>
            }
        </span>
        <span class="category-tree-node__label">@name</span>
        <CategoryStateMarkers Markers="Node.Labels" BgGlow="false"/>
    </button>
</li>

@code {
    [CascadingParameter(Name = "ShopLanguage")]
    public string Language { get; set; } = "en";

    [Parameter]
    [EditorRequired]
    public required ShopMenuItem Node { get; set; }

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public EventCallback<ShopMenuItem> OnSelect { get; set; }
}
