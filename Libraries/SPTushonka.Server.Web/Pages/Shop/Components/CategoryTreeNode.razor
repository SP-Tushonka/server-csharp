@using SPTarkov.Server.Core.Models.Eft.Game
@using SPTarkov.Server.Core.Services.Commerce

@inject TarcoinStoreService TarcoinStoreService

@* Their button is a three column grid of marker, label and state icons. All three must be
   present for the label to land in the middle column. *@
<div class="category-tree-node">
    <button class="category-tree-node__button btn-grid-overlay @(Active ? "category-tree-node__button--active" : null)"
            @onclick="() => OnSelect.InvokeAsync(Node)">
        @if (!string.IsNullOrEmpty(Node.IconUrl))
        {
            <img class="category-tree__node-icon" src="@Node.IconUrl" alt=""/>
        }
        else
        {
            <span class="category-tree-node__marker">-</span>
        }
        <span class="category-tree-node__label">@TarcoinStoreService.Localise(Node.NameKey, Language)</span>
        <span class="category-tree-node__state-icons"></span>
    </button>
</div>

@code {
    [CascadingParameter(Name = "ShopLanguage")]
    public string Language { get; set; } = "en";

    [Parameter]
    [EditorRequired]
    public required ShopMenuItem Node { get; set; }

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public EventCallback<ShopMenuItem> OnSelect { get; set; }
}
