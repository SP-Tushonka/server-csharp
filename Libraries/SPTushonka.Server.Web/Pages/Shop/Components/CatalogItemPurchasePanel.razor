@using SPTarkov.Server.Core.Models.Eft.Game
@using SPTarkov.Server.Core.Services.Commerce
@using Microsoft.JSInterop
@inject IJSRuntime JS

@inject TarcoinStoreService TarcoinStoreService

<div class="catalog-item-page">
    <div class="catalog-item-page__body">
        <div class="catalog-item-page__content">
            <div class="product-tags catalog-item-page__tags pl-[13px]">
                @foreach (var tag in Block.Tags.Where(tag => ShopFormat.TagTexture(tag) is not null))
                {
                    <img class="product-tags__item" src="@ShopFormat.TagTexture(tag)" alt="@tag" draggable="false"/>
                }
            </div>

            <div class="catalog-item-page__gallery">
                <ProductGallery @key="Block.OfferId" Images="GalleryImages()"/>
                <div class="catalog-item-page__gallery__bg-mask"></div>
            </div>

            <div class="common__vignette"></div>

            <div class="catalog-item-page__details">
                <div class="catalog-item-summary">
                    <div class="catalog-item-summary__meta">
                        @if (!string.IsNullOrEmpty(Category))
                        {
                            <span>Category: @Category</span>
                        }
                    </div>
                    <h2 class="catalog-item-summary__title">@TarcoinStoreService.Localise(Block.NameKey, Language)</h2>
                </div>

                @{
                    // The text carries its own newlines. Blank ones are dropped and the rest become line breaks
                    var description = Offer is not null && !string.IsNullOrEmpty(Offer.DescriptionKey)
                        ? TarcoinStoreService.Localise(Offer.DescriptionKey, Language)
                        : TarcoinStoreService.Localise(Block.SubtitleKey, Language);
                    var lines = (description ?? string.Empty)
                        .Split('\n')
                        .Select(line => line.Trim())
                        .ToList();
                }

                <div class="catalog-item-description">
                    <p class="catalog-item-description__text">
                        @foreach (var line in lines)
                        {
                            @line
                            <br/>
                        }
                    </p>
                </div>

                @{
                    var contents = Contents();
                    var linked = Offer?.ShowRelatedOffers == true ? Offer.RelatedOffers : [];
                    var showingLinked = linked.Count > 0 && (_linkedTab || contents.Count == 0);
                    var cards = showingLinked ? linked : contents;
                }
                @if (cards.Count > 0)
                {
                    <div class="catalog-item-composition">
                        @* Tab width is calc(100% / var(--tab-columns)). Without the variable the
                           declaration is invalid and the tabs collapse to their content. *@
                        <div class="s-tab-view" style="--tab-columns: 2;">
                            <div class="s-tab-view__nav">
                                @* An empty tab stays in the dom hidden because it sizes the other one. *@
                                <button class="s-tab-view__tab @TabState(contents.Count, !showingLinked)" @onclick="() => _linkedTab = false">
                                    <span class="s-tab-view__tab-content">
                                        <div class="textures-icon textures-icon--tinted s-tab-view__tab-icon" style="@TintedIcon("ExpansionsHub_Offers_Icon.png")"></div>
                                        <span class="s-tab-view__tab-header">Edition contents</span>
                                        <span class="s-tab-view__tab-badge">(@contents.Count)</span>
                                    </span>
                                </button>
                                <button class="s-tab-view__tab @TabState(linked.Count, showingLinked)" @onclick="() => _linkedTab = true">
                                    <span class="s-tab-view__tab-content">
                                        <div class="textures-icon textures-icon--tinted s-tab-view__tab-icon" style="@TintedIcon("ExpansionsHub_Offers_Icon.png")"></div>
                                        <span class="s-tab-view__tab-header">Linked bundles</span>
                                        <span class="s-tab-view__tab-badge">(@linked.Count)</span>
                                    </span>
                                </button>
                            </div>

                            <div class="s-tab-view__panels">
                            <div class="s-tab-panel catalog-item-composition__bundle-carousel">
                                <div class="product-horizontal-carousel">
                                    <button class="product-horizontal-carousel__arrow" disabled aria-label="Scroll left">
                                        <div class="textures-icon textures-icon--tinted w-[16px] h-[28px] rotate-180" style="@TintedIcon("ExpansionsHub_Arrow.png", "rgb(88, 93, 96)")"></div>
                                    </button>
                                    <div class="product-horizontal-carousel__viewport">
                                        <div class="product-horizontal-carousel__fade-left"></div>
                                        <div class="product-horizontal-carousel__fade-right"></div>
                                        <div class="product-horizontal-carousel__track">
                                            @foreach (var (part, index) in cards.Select((part, index) => (part, index)))
                                            {
                                                <div class="product-horizontal-carousel__slide product-horizontal-carousel__slide--square">
                                                    @{
                                                        var partOwned = PurchasedOffers?.Contains(part.Id.ToString()) ?? false;
                                                    }
                                                    <a class="product-horizontal-carousel__media@(partOwned ? " product-horizontal-carousel__media--purchased" : "")" href="@($"/shop/{Token}/catalog-item/{part.Id}")">
                                                        <div class="product-horizontal-carousel__counter">@(index + 1)</div>
                                                        <img class="product-horizontal-carousel__image" src="@part.Images.FirstOrDefault()?.Url" alt=""/>

                                                        @if (partOwned)
                                                        {
                                                            <div class="product-horizontal-carousel__media-purchased__vignette"></div>
                                                            <div class="product-horizontal-carousel__media-purchased__striped-lines"></div>
                                                            <div class="product-horizontal-carousel__media-purchased__logo">
                                                                <img class="textures-icon h-[110px] w-[90px]" src="/files/shop/ExpansionsHub_Anim_Banner_2.png" alt=""/>
                                                            </div>
                                                        }

                                                        <div class="product-horizontal-carousel__meta">
                                                            <div class="product-horizontal-carousel__name">@TarcoinStoreService.Localise(part.NameKey, Language)</div>
                                                            <div class="product-horizontal-carousel__description">@TarcoinStoreService.Localise(part.DescriptionKey, Language)</div>
                                                        </div>

                                                        <div class="product-horizontal-carousel__overlay">
                                                            <div class="product-horizontal-carousel__cta">
                                                                <div class="textures-icon textures-icon--tinted product-horizontal-carousel__cta-icon"
                                                                     style="@TintedIcon("ExpansionsHub_Links_MoveTo_Icon.png")"></div>
                                                                <span>Visit</span>
                                                            </div>
                                                        </div>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <button class="product-horizontal-carousel__arrow" aria-label="Scroll right">
                                        <div class="textures-icon textures-icon--tinted w-[16px] h-[28px]" style="@TintedIcon("ExpansionsHub_Arrow.png", "rgb(88, 93, 96)")"></div>
                                    </button>
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="catalog-item-purchase">
                @if (Purchased)
                {
                    <div class="catalog-item-purchase__purchased-block">
                        <div class="texture absolute inset-0"
                             style="background-image: url(/files/shop/ExpansionsHub_PriceTag_Background_Received.png); background-size: cover; background-repeat: no-repeat;"></div>
                        <span class="catalog-item-purchase__received">@TarcoinStoreService.Localise("common.status.received", Language)</span>
                    </div>
                }
                else
                {
                    var free = ShopFormat.IsFree(Block.Tags);
                    var percent = ShopFormat.DiscountPercent(Price);
                    var discounted = percent is not null && Price!.AmountWithDiscount > 0;
                    var priceTag = free ? "Free" : discounted ? "Sale" : "Default";

                    <div class="catalog-item-purchase__content">
                        <div class="texture !absolute inset-0"
                             style="background-image: url(/files/shop/ExpansionsHub_PriceTag_Background_@(priceTag).png); background-size: cover; background-repeat: no-repeat;"></div>

                        <div class="catalog-item-purchase__quantity-grid @(Block.Countable ? null : "invisible")">
                            <span></span>
                            <span>@TarcoinStoreService.Localise("common.labels.quantity", Language):</span>
                            <span class="font-bold">@Count</span>
                        </div>

                        <div class="catalog-item-purchase__price-row">
                            @if (!ShopFormat.IsTarcoinPriced(Block))
                            {
                                <span class="catalog-item-purchase__price-check">@TarcoinStoreService.Localise($"custom.{Block.OfferId}.priceCaption", Language)</span>
                            }
                            else if (Price is not null)
                            {
                                <div class="catalog-item-purchase__currency-block">
                                    <span class="catalog-item-purchase__currency">
                                        <img class="textures-icon h-full" src="/files/shop/ExpansionsHub_Currency_TC_Icon_1.png" alt=""/>
                                    </span>
                                </div>
                                <span class="catalog-item-purchase__price">@ShopFormat.Price(Price.AmountWithDiscount * Count)</span>
                                @if (discounted)
                                {
                                    <span class="catalog-item-purchase__old-price">@ShopFormat.Price(Price.Amount * Count)</span>
                                }
                            }
                        </div>

                        <div class="catalog-item-purchase__discount-row">
                            @if ((free || discounted) && percent is not null)
                            {
                                <div class="ticket-wrapper">
                                    <div class="ticket @(free ? "ticket-free" : "ticket-sale")">
                                        <div class="ticket-body">-@(percent)%</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="catalog-item-purchase__buy-row @(Block.Countable ? "pr-[40px]" : "px-[40px]")">
                        @if (Block.Countable && ShopFormat.IsTarcoinPriced(Block))
                        {
                            <SCounter Value="Count" Max="999" ValueChanged="value => Count = value"/>
                        }
                        <div class="purchase-single-button catalog-item-purchase__button">
                            <button class="button btn-grid-overlay @(free ? "button--purple" : "button--gold") button--md !w-full !h-full"
                                    disabled="@(Price is null || !ShopFormat.IsTarcoinPriced(Block))"
                                    @onclick="() => OnBuy.InvokeAsync(Count)">
                                <span class="button__content">
                                    <span class="button__label">
                                    <div class="flex gap-1 items-center">
                                        <img class="textures-icon @(free ? null : "mb-[7px]")"
                                             src="/files/shop/@(free ? "ExpansionsHub_MainButtons_Icon_Big_4.png" : "ExpansionsHub_MainButtons_Icon_1.png")" alt=""/>
                                        <span class="catalog-item-purchase__button-label">@TarcoinStoreService.Localise(free ? "features.purchase.buttons.get" : "features.purchase.buttons.buy", Language)</span>
                                    </div>
                                    </span>
                                </span>
                            </button>
                        </div>
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    ///     Enable the carousel arrows, which depend on the rendered widths
    /// </summary>
    /// <param name="firstRender">Whether this is the first render</param>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("shopLayoutCarousels");
    }

    private bool _linkedTab;
    private string? _shownOfferId;

    /// <summary>
    ///     Counter's quantity, kept while the item stays open and reset to one for the next
    /// </summary>
    private int Count { get; set; } = 1;

    protected override void OnParametersSet()
    {
        var offerId = Offer?.Id.ToString();
        if (offerId != _shownOfferId)
        {
            _shownOfferId = offerId;
            _linkedTab = false;
            Count = 1;
        }
    }

    private List<ShopRelatedOffer> Contents()
    {
        if (Offer is null || !Offer.ShowBundleComposition)
        {
            return [];
        }

        return Offer
            .Items.Where(item => item.OfferId is not null)
            .Select(item => new ShopRelatedOffer
            {
                Id = item.OfferId!.Value,
                NameKey = item.NameKey,
                DescriptionKey = item.DescriptionKey,
                Images = item.Images,
            })
            .ToList();
    }

    /// <summary>
    ///     Get the offer's demonstration items, or the tile banner when the offer has no catalog entry
    /// </summary>
    /// <returns>Entries for the gallery</returns>
    private List<ShopDemonstrationItem> GalleryImages()
    {
        if (Offer is not null && Offer.DemonstrationItems.Count > 0)
        {
            return Offer.DemonstrationItems;
        }

        var banner = Block.PurchasePopupImage ?? Block.Images.FirstOrDefault();

        return banner is null ? [] : [new ShopDemonstrationItem { Url = banner, ThumbUrl = banner }];
    }

    private static string TabState(int count, bool active)
    {
        return count == 0 ? "s-tab-view__tab--hidden" : active ? "s-tab-view__tab--active" : "";
    }

    private static string TintedIcon(string file, string colour = "rgb(176, 186, 193)")
    {
        var url = $"url(/files/shop/{file})";

        return $"-webkit-mask-image: {url}; mask-image: {url}; background-color: {colour};";
    }

    [CascadingParameter(Name = "ShopLanguage")]
    public string Language { get; set; } = "en";

    [Parameter]
    [EditorRequired]
    public required ShopBlock Block { get; set; }

    [Parameter]
    public ShopOffer? Offer { get; set; }

    [Parameter]
    public ShopPrice? Price { get; set; }

    [Parameter]
    public string? Token { get; set; }

    [Parameter]
    public string? Category { get; set; }

    [Parameter]
    public bool CanBuy { get; set; }

    [Parameter]
    public bool Purchased { get; set; }

    [Parameter]
    public HashSet<string>? PurchasedOffers { get; set; }

    /// <summary>
    ///     Buy the offer, passing the counter's quantity
    /// </summary>
    [Parameter]
    public EventCallback<int> OnBuy { get; set; }
}
