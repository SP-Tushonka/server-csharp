<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\Build.props" />
  <PropertyGroup>
    <PackageId>SPTushonka.Server</PackageId>
    <RootNamespace>SPTarkov.Server</RootNamespace>
    <Authors>Single Player Tushonka</Authors>
    <Description>Single Player Tushonka server launcher.</Description>
    <Copyright>Copyright (c) Single Player Tushonka 2026</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://sp-mod.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SP-Tushonka/server-csharp</RepositoryUrl>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>SPT.Server</AssemblyName>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <!-- Has to be enabled for SPTushonka.Server.Web to function properly-->
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>
    <StaticWebAssetBasePath>..\SPT_Data\wwwroot\</StaticWebAssetBasePath>
    <!-- Required for .Net 10 to provide the web assets for Blazor-->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ApplicationIcon>..\Libraries\SPTushonka.Server.Assets\SPT_Data\images\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <AssemblyName>SPT.Server.Linux</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <AssemblyName>SPT.Server.Mac</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Libraries\SPTushonka.Reflection\SPTushonka.Reflection.csproj" />
    <ProjectReference Include="..\Libraries\SPTushonka.Server.Core\SPTushonka.Server.Core.csproj" />
    <ProjectReference Include="..\Libraries\SPTushonka.Server.Assets\SPTushonka.Server.Assets.csproj" />
    <ProjectReference Include="..\Libraries\SPTushonka.Server.Web\SPTushonka.Server.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AsmResolver.DotNet" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <ExcludeFromSingleFile>True</ExcludeFromSingleFile>
    </Content>
    <None Update="sptLogger.json" Condition="'$(SptBuildType)' == 'RELEASE'">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="sptLogger.Development.json" Condition="'$(SptBuildType)' != 'RELEASE'">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>
  <Target Name="RelocateSatelliteAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_RelocatedSatelliteCulture
        Include="@(ReferenceCopyLocalPaths->'%(DestinationSubDirectory)')"
        Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').EndsWith('.resources'))"
      />
      <ReferenceCopyLocalPaths Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').EndsWith('.resources'))">
        <DestinationSubDirectory>SPT_Data\dotnet\%(ReferenceCopyLocalPaths.DestinationSubDirectory)</DestinationSubDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>
  <Target Name="RelocatePublishedSatelliteAssemblies" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').EndsWith('.resources'))">
        <RelativePath>SPT_Data\dotnet\%(ResolvedFileToPublish.RelativePath)</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CleanStaleSatelliteFolders" AfterTargets="Build" Condition="'@(_RelocatedSatelliteCulture)' != ''">
    <RemoveDir Directories="@(_RelocatedSatelliteCulture->'$(OutDir)%(Identity)')" />
  </Target>
</Project>
